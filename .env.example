# Copy this file to .env.local and fill in any you want to enable.
# All are optional — the Support page and footer button hide themselves
# automatically when none are set. No specific provider is required.

VITE_SUPPORT_DONATION_URL=
VITE_SUPPORT_SPONSORSHIP_URL=
VITE_SUPPORT_OTHER_URL=

# Public origin of the deployed site, e.g. https://bench.example — enables
# sitemap.xml and absolute canonical / Open Graph URLs. Optional.
VITE_SITE_URL=
