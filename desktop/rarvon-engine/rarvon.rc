// Windows resources for Rarvon.exe: the icon Explorer and the taskbar show,
// and the details in the file's Properties. build.rs fills in the RARVON_ names.
1 ICON "RARVON_ICON"

1 VERSIONINFO
FILEVERSION RARVON_VERSION_NUMBERS
PRODUCTVERSION RARVON_VERSION_NUMBERS
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "ROBEE"
      VALUE "FileDescription", "Rarvon"
      VALUE "FileVersion", "RARVON_VERSION"
      VALUE "ProductName", "Rarvon for desktop (beta)"
      VALUE "ProductVersion", "RARVON_VERSION"
      VALUE "LegalCopyright", "Copyright ROBEE. All rights reserved."
      VALUE "OriginalFilename", "Rarvon.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
